# 登录凭据（生产环境请使用强密码和至少 32 字符的随机会话密钥）
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me
SESSION_SECRET=replace-with-at-least-32-random-characters

# SQLite 文件位置；相对路径以 site 目录为基准
SQLITE_PATH=./data/maoyan.db

# WxPusher 标准推送：UID 与 Topic ID 均支持英文逗号分隔
WXPUSHER_APP_TOKEN=
WXPUSHER_UIDS=
WXPUSHER_TOPIC_IDS=

# 后台轮询间隔（毫秒）
TICKET_WATCH_INTERVAL_MS=60000
